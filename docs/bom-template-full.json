{
  "_说明": "工程用的一套：比 Ican 格式多了层级、单重、总重、备注。复制到项目根目录改名 bom-template.json 即可。",
  "columns": [
    ["序号", "no"],
    ["层级", "level"],
    ["图号", "code"],
    ["名称", "name"],
    ["数量", "qty"],
