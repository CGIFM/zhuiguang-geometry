    ["表面处理", "surface"],
    ["品牌", "brand"],
    ["零件类型", "ptype"],
    ["单位", "unit"],
    ["单重(kg)", "unit_mass"],
    ["总重(kg)", "total_mass"],
    ["备注", "note"]
  ]
}
